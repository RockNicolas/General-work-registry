# Copie para .env (`cp .env.example .env`). Nunca versione o .env.

# Postgres no Neon. Use a connection string DIRETA (host SEM "-pooler"): o pg-boss e as
# migrations precisam dela. Desenvolvimento e testes usam o branch "develop" do Neon.
# Produção NÃO fica neste arquivo: vai nas variáveis de ambiente do serviço de hospedagem.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=verify-full

# Alternativa local (docker compose up -d db):
# DATABASE_URL=postgres://rgo:rgo@localhost:5432/rgo

# Autenticação (Better Auth). Segredo com 32+ caracteres; gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# URL pública do app (padrão: http://localhost:3000)
# BETTER_AUTH_URL=http://localhost:3000
